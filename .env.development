# BentoPDF Environment Variables - Development

# Dev-only: route TSA/certificate requests through the built-in Vite CORS proxy
VITE_CORS_PROXY_URL=/cors-proxy
VITE_CORS_PROXY_SECRET=

# WASM Module URLs (Using your custom CDN)
VITE_WASM_PYMUPDF_URL=https://pdf.mepcell.com/CDN/pymupdf-wasm@0.11.16/
VITE_WASM_GS_URL=https://pdf.mepcell.com/CDN/gs-wasm@0.1.1/assets/
VITE_WASM_CPDF_URL=https://pdf.mepcell.com/CDN/coherentpdf@2.5.5/dist/

# OCR assets (Using your custom CDN)
VITE_TESSERACT_WORKER_URL=https://pdf.mepcell.com/CDN/tesseract/worker/dist/worker.min.js
VITE_TESSERACT_CORE_URL=https://pdf.mepcell.com/CDN/tesseract/core
VITE_TESSERACT_LANG_URL=https://pdf.mepcell.com/CDN/tesseract/langdata
VITE_TESSERACT_AVAILABLE_LANGUAGES=fas,eng,deu,chi_sim,chi_tra
VITE_OCR_FONT_BASE_URL=https://pdf.mepcell.com/CDN/tesseract/fonts

# Default UI language (build-time)
VITE_DEFAULT_LANGUAGE=fas

# Custom branding (build-time)
VITE_BRAND_NAME=Mana Energy Pak Offline PDF Tools
VITE_BRAND_LOGO=/images/manaLogo.svg
VITE_FOOTER_TEXT=ICT Department of Mana Energy Pak